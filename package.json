{
  "name": "reelforge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, AI-powered vertical video (Reels/Shorts/TikTok) editor. Your laptop does the work; every device gets the app.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @reelforge/server start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @reelforge/web test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
