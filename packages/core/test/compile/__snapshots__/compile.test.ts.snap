    "C:\\out\\job.mp4.part",
  ],
  "graph": [
    "[0:v]setpts=PTS-STARTPTS,fps=30,tpad=stop_mode=clone:stop=60,trim=end_frame=60[s0];",
    "[s0]scale=w=720:h=1280:flags=lanczos,format=yuv420p[s1];",
    "[s1]setsar=1,format=yuv420p[s2];",
    "[1:v]setpts=PTS-STARTPTS,fps=30,tpad=stop_mode=clone:stop=45,trim=end_frame=45[s3];",
    "[s3]scale=w=1138:h=640:flags=lanczos,format=yuv420p[s4];",
    "[s2]split=2[s5][s6];",
    "[s5]trim=start_frame=0:end_frame=45,setpts=PTS-STARTPTS[s7];",
    "[s7]split=2[s8][s9];",
    "color=c=black@0:s=720x1280:r=30,format=yuva420p,trim=end_frame=45[s10];",
    "[s10][s4]overlay=x=540*0.666667-overlay_w/2:y=960*0.666667-overlay_h/2:eval=init:format=yuv420[s11];",
    "[s11]split=2[s12][s13];",
    "[s12]format=gbrp[s14];",
    "[s8]format=gbrp[s15];",
    "[s15][s14]blend=all_mode=screen,format=yuv420p[s16];",
    "[s13]alphaextract[s17];",
    "[s16][s17]alphamerge[s18];",
    "[s9][s18]overlay=format=yuv420[s19];",
    "[s6]trim=start_frame=45,setpts=PTS-STARTPTS[s20];",
    "[s19][s20]concat=n=2:v=1:a=0[s21];",
    "[2:v]scale=w=360:h=360:force_original_aspect_ratio=decrease:flags=lanczos:out_color_matrix=bt709:out_range=tv,format=yuva420p,pad=360:360:(ow-iw)/2:(oh-ih)/2:color=black@0[s22];",
    "[s22]settb=1/30,loop=loop=29:size=1:start=0,setpts=N,fps=30,trim=end_frame=30[s23];",
    "[s23]rotate=a=0.261799:ow=rotw(0.261799):oh=roth(0.261799):c=none:bilinear=1[s24];",
    "[s24]setpts=PTS+0.5/TB[s25];",
    "[s21][s25]overlay=x=540*0.666667-overlay_w/2:y=960*0.666667-overlay_h/2:eval=init:format=yuv420:eof_action=pass:repeatlast=0:enable='between(n,15,44)'[s26];",
    "[s26]format=yuv420p,setparams=range=tv:color_primaries=bt709:color_trc=bt709:colorspace=bt709[s27];",
    "[0:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS,atrim=end=2[s28];",
    "[s28]apad=whole_len=96000,atrim=end_sample=96000[s29];",
    "[1:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS,atrim=end=1.5[s30];",
    "[s30]apad=whole_len=72000,atrim=end_sample=72000[s31];",
    "[s29][s31]amix=inputs=2:duration=longest:dropout_transition=0:normalize=0[s32];",
