  ],
  "graph": [
    "[0:v]setpts=PTS-STARTPTS,fps=30,tpad=stop_mode=clone:stop=60,trim=end_frame=60[s0];",
    "[s0]crop=w=iw*0.316406:h=ih*1:x=iw*0.341797:y=ih*0,scale=w=1080:h=1920:flags=lanczos,format=yuv420p[s1];",
    "[s1]lutyuv=y='st(0,clip((val-16)/219,0,1));st(0,(ld(0)-0.5)*1.075+0.5);round(clip(16+219*ld(0),16,235))':u='st(0,(val-128)/112);st(0,ld(0)*1.1);round(clip(128+112*ld(0),16,240))':v='st(0,(val-128)/112);st(0,ld(0)*1.1);round(clip(128+112*ld(0),16,240))'[s2];",
    "[s2]setsar=1,format=yuv420p[s3];",
    "[1:v]setpts=PTS-STARTPTS,fps=30,tpad=stop_mode=clone:stop=60,trim=end_frame=60[s4];",
    "[s4]scale=w=1080:h=1920:flags=lanczos,format=yuv420p[s5];",
    "[s5]lut3d=file='C\\:/packs/pack/luts/teal.cube':interp=tetrahedral,format=yuv420p[s6];",
    "[s6]setsar=1,format=yuv420p[s7];",
    "[s3][s7]xfade=transition=slideleft:duration=0.3:offset=1.7[s9];",
    "[2:v]crop=w=iw*0.423437:h=ih*1:x=iw*0.288281:y=ih*0,scale=w=1084:h=1920:flags=lanczos:out_color_matrix=bt709:out_range=tv,format=yuv420p[s10];",
    "[s10]settb=1/30,loop=loop=44:size=1:start=0,setpts=N,fps=30,trim=end_frame=45[s11];",
    "[s11]perspective=x0='(542+(0-(540*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':y0='(960+(0-(960*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':x1='(542+(1084-(540*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':y1='(960+(0-(960*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':x2='(542+(0-(540*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':y2='(960+(1920-(960*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':x3='(542+(1084-(540*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':y3='(960+(1920-(960*1))/(if(lt((in/30),1.5),if(lt((in/30),0),1,(1+0.15*(((in/30)-0)/1.5))),1.15)/1))':interpolation=linear:eval=frame,crop=1080:1920:0:0[s12];",
    "[s12]setsar=1,format=yuv420p[s13];",
    "[s9][s13]xfade=transition=smoothleft:duration=0.4:offset=3.3,sendcmd=c='3.283333 gblur@tr14 sigma 0.01;3.316667 gblur@tr14 sigma 15.53;3.35 gblur@tr14 sigma 30;3.383333 gblur@tr14 sigma 42.43;3.416667 gblur@tr14 sigma 51.96;3.45 gblur@tr14 sigma 57.96;3.483333 gblur@tr14 sigma 60;3.516667 gblur@tr14 sigma 57.96;3.55 gblur@tr14 sigma 51.96;3.583333 gblur@tr14 sigma 42.43;3.616667 gblur@tr14 sigma 30;3.65 gblur@tr14 sigma 15.53;3.683333 gblur@tr14 sigma 0.01',gblur@tr14=sigma=0.01:sigmaV=0.01:steps=2:enable='between(t,3.3,3.7)'[s15];",
    "[s15]ass=filename='C\\:/tmp/text.ass':fontsdir='C\\:/packs/fonts'[s16];",
    "[s16]format=yuv420p,setparams=range=tv:color_primaries=bt709:color_trc=bt709:colorspace=bt709[s17];",
    "[0:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS,atrim=end=2[s18];",
    "[s18]apad=whole_len=96000,atrim=end_sample=96000,afade=t=out:st=1.7:d=0.3:curve=qsin[s19];",
    "[1:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS,atrim=end=2[s20];",
    "[s20]apad=whole_len=96000,atrim=end_sample=96000,afade=t=in:st=0:d=0.3:curve=qsin,afade=t=out:st=1.6:d=0.4:curve=qsin,adelay=delays=81600S:all=1[s21];",
    "[3:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asetpts=PTS-STARTPTS,atrim=end=4.8[s22];",
    "[s22]apad=whole_len=230400,atrim=end_sample=230400,afade=t=out:st=3.8:d=1[s23];",
    "[s19][s21]amix=inputs=2:duration=longest:dropout_transition=0:normalize=0[s24];",
    "[s24]asplit=2[s25][s26];",
    "[s23][s26]sidechaincompress=threshold=0.03:ratio=8:attack=15:release=350[s27];",
    "[s25][s27]amix=inputs=2:duration=longest:dropout_transition=0:normalize=0[s28];",
    "[s28]apad=whole_len=230400,atrim=end_sample=230400,loudnorm=I=-14:TP=-1.5:LRA=11,aresample=48000,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo[s29]",
  ],
}
`;

exports[`graph snapshots > overlay with blend mode, sticker and range 1`] = `
{
