{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["vite/client", "vite-plugin-pwa/vanillajs"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test"],
  "exclude": ["src/sw.ts"]
}
